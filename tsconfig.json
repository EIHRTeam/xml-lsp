{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "WebWorker"],
    "types": ["node", "vscode"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@eihrteam/xml-language-service": ["./packages/language-service/src/index.ts"],
      "@eihrteam/xml-language-server": ["./packages/language-server/src/index.ts"],
      "@eihrteam/xml-browser-client": ["./packages/browser-client/src/index.ts"],
      "@eihrteam/xml-lsp/browser-client": ["./packages/browser-client/src/index.ts"],
      "@eihrteam/xml-monaco-client": ["./packages/monaco-client/src/index.ts"],
      "@eihrteam/xml-ace-client": ["./packages/ace-client/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "extensions/**/src/*.ts",
    "examples/**/*.ts",
    "tooling/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
